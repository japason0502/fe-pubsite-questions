    "pseudoCode": [
      "○論理型：checkPw（文字列型：pw）",
      "  論理型：hasUpper ← false, hasLower ← false, hasDigit ← false",
      "  整数型：i, run ← 1",
      "  if（pw の文字数 が 8 未満）",
      "    return false",
      "  endif",
      "  for（i を 1 から pw の文字数 まで 1 ずつ増やす）",
      "    if（isUpper（pw の i 文字目））",
      "      hasUpper ← true",
      "    elseif（isLower（pw の i 文字目））",
      "      hasLower ← true",
      "    elseif（isDigit（pw の i 文字目））",
      "      hasDigit ← true",
      "    endif",
      "    if（i が 2 以上）",
      "      if（（pw の i 文字目）が（pw の（i − 1）文字目）と等しい）",
      "        run ← run + 1",
      "        if（run が【　　　】以上）",
      "          return false",
      "        endif",
      "      else",
      "        run ← 1",
      "      endif",
      "    endif",
      "  endfor",
      "  if（hasUpper and hasLower and hasDigit）",
